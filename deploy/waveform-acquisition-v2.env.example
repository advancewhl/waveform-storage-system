# Bind only to localhost during initial validation. Use an SSH tunnel from the GUI.
WAVEFORM_SERVER_ENDPOINT=tcp://127.0.0.1:5001
WAVEFORM_ALLOW_REMOTE_BIND=false
WAVEFORM_MAX_CAPTURE_SECONDS=3600
WAVEFORM_MAX_CAPTURE_DEVICES=1
WAVEFORM_SERVER_REGISTRY=/home/storage-user/waveform-storage-v2/config/devices.json
WAVEFORM_TASK_STATE_DIR=/home/storage-user/waveform-storage-v2/state
WAVEFORM_STAGING_ROOT=/home/storage-user/waveform-storage-v2/staging
WAVEFORM_LOCAL_DATA_ROOT=/SHINE_Data/AC/LA

# Device EPICS and SSH
WAVEFORM_EPICS_CONNECT_TIMEOUT_SECONDS=10
WAVEFORM_EPICS_PULSE_SECONDS=5
WAVEFORM_DEVICE_SSH_USER=root
WAVEFORM_DEVICE_SSH_PASSWORD=
WAVEFORM_DEVICE_SSH_KEY_FILE=
WAVEFORM_DEVICE_SSH_KNOWN_HOSTS=/home/storage-user/waveform-storage-v2/known_hosts
WAVEFORM_SSH_CONNECT_TIMEOUT_SECONDS=30
WAVEFORM_SSH_MAX_WORKERS=4
WAVEFORM_REMOTE_FILE_SETTLE_SECONDS=2

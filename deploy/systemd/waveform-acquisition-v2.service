[Unit]
Description=SHINE waveform acquisition protocol-v2 service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=storage-user
Group=storage-user
WorkingDirectory=/home/storage-user/waveform-storage-v2/app
EnvironmentFile=/home/storage-user/waveform-storage-v2/service.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/storage-user/miniconda3/envs/waveform-storage-v2/bin/python apps/acquisition_server/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/SHINE_Data /home/storage-user/waveform-storage-v2

[Install]
WantedBy=multi-user.target

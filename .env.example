# GUI -> acquisition service
WAVEFORM_ZMQ_SERVER_HOST=
WAVEFORM_ZMQ_SERVER_PORT=5000
WAVEFORM_ZMQ_RECEIVE_TIMEOUT_MS=3000

# Central HDF5 storage
WAVEFORM_STORAGE_HOST=
WAVEFORM_STORAGE_USER=
WAVEFORM_STORAGE_PASSWORD=
WAVEFORM_STORAGE_PORT=22
WAVEFORM_STORAGE_DATA_ROOT=/SHINE_Data/AC/LA

# BPM device access
WAVEFORM_DEVICE_SSH_USER=
WAVEFORM_DEVICE_SSH_PASSWORD=
WAVEFORM_DEVICE_REMOTE_DIR=/home/data
WAVEFORM_DEVICE_SSH_PORT=22

# Acquisition output and optional config override
WAVEFORM_LOCAL_DATA_ROOT=/SHINE_Data/AC/LA
WAVEFORM_CONFIG_DIR=
WAVEFORM_SSH_CONNECT_TIMEOUT_SECONDS=30
WAVEFORM_EPICS_CONNECT_TIMEOUT_SECONDS=10
WAVEFORM_ALIGNMENT_EXPORT_FORMAT=auto

# Candidate-v2 acquisition service (deploy separately from legacy port 5000)
WAVEFORM_SERVER_ENDPOINT=tcp://127.0.0.1:5001
WAVEFORM_ALLOW_REMOTE_BIND=false
WAVEFORM_MAX_CAPTURE_SECONDS=3600
WAVEFORM_MAX_CAPTURE_DEVICES=32
WAVEFORM_SERVER_REGISTRY=
WAVEFORM_TASK_STATE_DIR=
WAVEFORM_STAGING_ROOT=
WAVEFORM_EPICS_PULSE_SECONDS=5
WAVEFORM_SSH_MAX_WORKERS=17
WAVEFORM_REMOTE_FILE_SETTLE_SECONDS=2
WAVEFORM_DEVICE_SSH_KEY_FILE=
WAVEFORM_DEVICE_SSH_KNOWN_HOSTS=

# Candidate-v2 GUI/client endpoint
WAVEFORM_CANDIDATE_ZMQ_ENDPOINT=
# Explicit field-test override when the GUI host cannot reach the timing PV.
WAVEFORM_CAPTURE_FREQUENCY_HZ=

# Optional MongoDB metadata catalog. Waveform arrays remain in HDF5.
WAVEFORM_MONGODB_ENABLED=false
WAVEFORM_MONGODB_URI=
WAVEFORM_MONGODB_DATABASE=waveform_storage
WAVEFORM_MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
# true makes candidate-v2 startup fail when MongoDB is unavailable.
WAVEFORM_MONGODB_REQUIRED=false

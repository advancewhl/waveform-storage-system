{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 7000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "starter-vendored-static-libs",
        "action": "observe",
        "pattern": "**/static/**/libs/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 100,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-static-lib",
        "action": "observe",
        "pattern": "**/static/**/lib/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 101,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-static-plugins",
        "action": "observe",
        "pattern": "**/static/**/plugins/**",
        "pattern_kind": "glob",

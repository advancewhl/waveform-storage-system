        "source": "builtin",
        "created_by": "aoci-init",
        "order": 102,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-min-js",
        "action": "observe",
        "pattern": "**/*.min.js",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 103,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-min-css",
        "action": "observe",
        "pattern": "**/*.min.css",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 104,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-source-map",
        "action": "observe",
        "pattern": "**/*.map",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 105,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-fonts",
        "action": "observe",
        "pattern": "**/fonts/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 106,
        "enabled": true
      },
      {
        "rule_id": "pilot-protected-deploy-script",
        "action": "exclude",
        "pattern": "tools/deploy_candidate_release.py",
        "pattern_kind": "file",
        "reason": "用户明确保护的未跟踪发布脚本；此轮不读取、不纳入认知",
        "source": "user",
        "created_by": "whloong",
        "order": 201,
        "enabled": true
      },
      {
        "rule_id": "pilot-local-spectrum-results",
        "action": "exclude",
        "pattern": "analysis/high_frequency/数据结果",
        "pattern_kind": "directory",
        "reason": "本地频谱交付结果，排除受保护 ZIP 与机器结果",
        "source": "user",
        "created_by": "whloong",
        "order": 202,
        "enabled": true
      },
      {
        "rule_id": "pilot-build-cache",
        "action": "exclude",
        "pattern": ".build-cache",
        "pattern_kind": "directory",
        "reason": "本地构建缓存，不属于核心系统认知",
        "source": "user",
        "created_by": "whloong",
        "order": 203,
        "enabled": true
      },
      {
        "rule_id": "pilot-logs",
        "action": "exclude",
        "pattern": "**/*.log",
        "pattern_kind": "glob",
        "reason": "运行与构建日志不属于高优先级代码认知",

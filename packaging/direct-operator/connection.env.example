# Copy to connection.env and edit for the new computer's DIRECT route.
WAVEFORM_STORAGE_HOST=192.0.2.2
WAVEFORM_STORAGE_USER=storage-user
WAVEFORM_STORAGE_PORT=22
# Optional: path to a private key already installed on this computer.
# WAVEFORM_SSH_IDENTITY_FILE=/home/USER/.ssh/id_ed25519
# Optional shared state directory on a multi-user desktop.
# WAVEFORM_OPERATOR_STATE_DIR=/home/site-user/work/StreamDataPro_new/.waveform-operator-state-desktop-user-a
